# Rhythm & Flow API settings for AWS.
#
# 1. Copy this file to app-settings.env (that name is git-ignored - NEVER commit it).
# 2. Fill in each value from Azure: App Service -> Settings -> Environment variables -> "Show value".
# 3. Upload app-settings.env to CloudShell next to setup-aws.sh and run the script.
#
# One setting per line, NAME=value. No quotes needed. Keep each value on one line.
# Lines left empty are skipped. Leave out anything you don't use.
#
# Not needed here (handled automatically): ConnectionStrings__Default, Database__Provider,
# PayFast__PublicBaseUrl, and the Azure-only APPLICATIONINSIGHTS_*, ApplicationInsightsAgent_*,
# XDT_* and WEBSITE_* settings.

# --- Security keys (required) ---
Jwt__Key=
Media__SigningKey=

# --- PayFast ---
PayFast__MerchantId=
PayFast__MerchantKey=
PayFast__Passphrase=
PayFast__Sandbox=
PayFast__ValidateWithServer=

# --- Email (SMTP) ---
Smtp__Host=
Smtp__Port=
Smtp__User=
Smtp__Password=
Smtp__FromAddress=
Smtp__EnableSsl=

# --- Admin alerts ---
Admin__AlertEmails__0=

# --- Firebase (not used by the code on GitHub yet; keep it if a newer version needs it) ---
Firebase__ServiceAccountJson=

# --- Seed users ---
Seed__Users__0__Email=
Seed__Users__0__FullName=
Seed__Users__0__Password=
Seed__Users__0__Role=
Seed__Users__0__Username=
Seed__Users__1__Email=
Seed__Users__1__FullName=
Seed__Users__1__Password=
Seed__Users__1__Role=
Seed__Users__1__Username=
